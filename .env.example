# Required when using cloud (Groq) mode.
GROQ_API_KEY=your_groq_api_key_here

# Optional; defaults to the lightweight local vision model shown here.
OLLAMA_MODEL=moondream

# Optional; defaults to the local Ollama service shown here.
OLLAMA_HOST=http://127.0.0.1:11434

# Default cloud provider (groq or nvidia) for requests that don't name one.
# The popup sends its Model route selection with every request, which takes precedence.
AI_PROVIDER=groq

# When the selected provider fails for infrastructure reasons (worker capacity
# exhausted, rate limit, timeout, unreachable), the request is retried on every
# other configured provider before failing. The error reported to the extension
# is always the selected provider's own. Set to 0 to report the first failure
# instead and never switch provider.
AI_FALLBACK=1

# Ollama is excluded from automatic fallback: the local model is far slower
# than the cloud wait it would be replacing. Set to 1 to add it to the end of
# the chain anyway. Choosing Local (Ollama) in the popup is unaffected.
AI_FALLBACK_OLLAMA=0

# Optional; Groq vision model for actions and screenshot verification.
# GROQ_MODEL=

# Required when AI_PROVIDER=nvidia. Server-side only; never sent to the extension.
NVIDIA_API_KEY=your_nvidia_api_key_here

# Required when AI_PROVIDER=nvidia. There is no default: set the NVIDIA model
# your account can access. It must be a vision model - the agent sends the
# redacted screenshot to it.
NVIDIA_MODEL=

# Optional; comma-separated NVIDIA vision models to retry on when NVIDIA_MODEL
# is reachable but cannot serve the request (HTTP 503 ResourceExhausted, rate
# limits, models not served to this key). Set to an empty value to disable.
# Default: meta/llama-3.2-11b-vision-instruct
# NVIDIA_FALLBACK_MODELS=meta/llama-3.2-11b-vision-instruct
