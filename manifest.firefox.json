{
  "manifest_version": 3,
  "name": "Privacy Vision Agent",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  },
  "description": "Extension shell for a privacy-preserving browser agent.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "privacy-vision-agent@example.com",
      "strict_min_version": "109.0"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' http://127.0.0.1:8000; img-src 'self' data:;"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open Privacy Vision Agent"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true
    }
  ]
}
